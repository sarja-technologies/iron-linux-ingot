#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # Unprivileged account that runs QEMU for VM agents.
    if ! getent passwd iron-agent-vm >/dev/null; then
        adduser --system --group --no-create-home --home /nonexistent iron-agent-vm >/dev/null
    fi
    adduser iron-agent-vm kvm >/dev/null 2>&1 || true
    # 0711: traversable (VM agents run QEMU as iron-agent-vm) but not listable.
    install -d -m 711 /var/lib/iron/agents
    install -d -m 755 /var/lib/iron/agent-images
fi
#DEBHELPER#
