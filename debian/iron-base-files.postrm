#!/bin/sh
set -e
# Restore Ubuntu's identity files once ours are gone.
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
    for f in /usr/lib/os-release /etc/lsb-release /etc/issue /etc/issue.net /etc/legal /etc/update-motd.d/10-help-text; do
        dpkg-divert --package iron-base-files --remove --rename --divert "$f.ubuntu" "$f"
    done
fi
#DEBHELPER#
