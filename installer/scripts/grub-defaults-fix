#!/bin/sh
# Runs inside the installed system, after Calamares' grubcfg module.
set -eu
f=/etc/default/grub
[ -f "$f" ] || exit 0
sed -i -E 's/ ?cryptdevice=[^ '"'"'"]*//g; s# ?root=/dev/mapper/[^ '"'"'"]*##g' "$f"
grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$f" && grep '^GRUB_CMDLINE_LINUX_DEFAULT=' "$f" \
    >>/var/log/installer/iron-postinstall.log 2>/dev/null || true
