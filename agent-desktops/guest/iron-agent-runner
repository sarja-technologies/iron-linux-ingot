#!/usr/bin/python3
"""iron-agent-runner - executes the owner's instructions inside an Agent Desktop.

Runs as root inside the (unprivileged, isolated) agent. For each instruction in
the control inbox it starts the configured runtime as the `agent` user, in a
visible terminal on the agent's display, logging to ~/outbox/logs. It also
serves `iron-elevate` requests: root commands that the host owner approved.
"""
import hashlib
import json
import os
import pwd
import shlex
import socket
import subprocess
import threading
import time

CONTROL = "/run/iron-agent/control"
INBOX = os.path.join(CONTROL, "inbox")
STATUS = os.path.join(CONTROL, "status.json")
RUNTIME_CONF = "/etc/iron-agent/runtime.json"
RUNTIME_DIR = "/usr/share/iron-agents/runtimes"
ELEVATE_SOCK = "/run/iron-agent-elevate.sock"
AGENT = pwd.getpwnam("agent")
HOME = AGENT.pw_dir
OUTBOX = os.path.join(HOME, "outbox")
WORKSPACE = os.path.join(HOME, "workspace")

state = {"task": 0, "state": "idle", "summary": ""}
status_lock = threading.Lock()


def write_status(**kw):
    with status_lock:
        state.update(kw, updated=time.time())
        tmp = STATUS + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, STATUS)


def runtime():
    rid = "shell"
    try:
        with open(RUNTIME_CONF) as f:
            rid = json.load(f).get("runtime", "shell")
    except (OSError, ValueError):
        pass
    try:
        with open(os.path.join(RUNTIME_DIR, f"{rid}.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        with open(os.path.join(RUNTIME_DIR, "shell.json")) as f:
            return json.load(f)


def in_vm():
    try:
        with open("/proc/cmdline") as f:
            return "iron.agent=1" in f.read().split()
    except OSError:
        return False


# Container agents draw on Xvnc :1; VM agents on the VM's own screen, Xorg :0.
DISPLAY = ":0" if in_vm() else ":1"
XAUTH = "/run/iron-agent/xauth"
# Exit status of each task, written by the task terminal (agent-owned).
TASK_DIR = "/run/iron-agent/tasks"


def agent_env():
    env = {"HOME": HOME, "USER": "agent", "LOGNAME": "agent", "SHELL": "/bin/bash",
           "PATH": f"{HOME}/.local/bin:{HOME}/.npm-global/bin:/usr/local/bin:/usr/bin:/bin",
           "DISPLAY": DISPLAY, "LANG": "C.UTF-8", "IRON_AGENT": "1"}
    if os.path.exists(XAUTH):
        env["XAUTHORITY"] = XAUTH
    return env


def wait_for_display(timeout=120):
    """True once the agent's X server accepts clients. Its socket appears before
    it does (and Xorg may restart once while the virtual GPU comes up)."""
    sock = f"/tmp/.X11-unix/X{DISPLAY[1:]}"
    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(sock):
            r = subprocess.run(["xset", "q"], env=agent_env(), user=AGENT.pw_uid, group=AGENT.pw_gid,
                               extra_groups=[], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if r.returncode == 0:
                return True
        time.sleep(1)
    return False


def run_instruction(text):
    rt = runtime()
    state["task"] += 1
    n = state["task"]
    os.makedirs(os.path.join(OUTBOX, "logs"), exist_ok=True)
    os.chown(OUTBOX, AGENT.pw_uid, AGENT.pw_gid)
    os.chown(os.path.join(OUTBOX, "logs"), AGENT.pw_uid, AGENT.pw_gid)
    log = os.path.join(OUTBOX, "logs", f"task-{n:03d}.log")
    argv = [a.replace("{instruction}", text) for a in rt["instruction"]]
    write_status(state="working", summary=text[:200])
    if not wait_for_display():
        write_status(state="failed", summary=f"Task {n}: the agent desktop (display {DISPLAY}) did not start")
        return
    # The task reports its own exit status, so it counts as finished as soon as
    # the command ends; the terminal stays open afterwards for the owner to read.
    os.makedirs(TASK_DIR, mode=0o700, exist_ok=True)
    os.chown(TASK_DIR, AGENT.pw_uid, AGENT.pw_gid)
    rc_file = os.path.join(TASK_DIR, f"task-{n:03d}.rc")
    if os.path.exists(rc_file):
        os.unlink(rc_file)
    script = (f"cd {shlex.quote(WORKSPACE)} && echo '# Iron Agent task {n}' && "
              f"{shlex.join(argv)} 2>&1 | tee {shlex.quote(log)}; "
              f"echo ${{PIPESTATUS[0]}} > {shlex.quote(rc_file)}.tmp && mv {shlex.quote(rc_file)}.tmp {shlex.quote(rc_file)}; "
              f"echo; echo '[task {n} finished - press Enter to close]'; read -r _")
    term = ["xterm", "-title", f"Agent task {n}", "-geometry", "140x40", "-e", "bash", "-lc", script]
    err_path = os.path.join(TASK_DIR, f"task-{n:03d}.terminal.log")
    with open(err_path, "w") as err:
        proc = subprocess.Popen(term, env=agent_env(), user=AGENT.pw_uid, group=AGENT.pw_gid,
                                extra_groups=[], cwd=WORKSPACE, start_new_session=True,
                                stdout=err, stderr=subprocess.STDOUT)
    rc = None
    while rc is None:
        try:
            with open(rc_file) as f:
                rc = int(f.read().strip() or "1")
        except (OSError, ValueError):
            if proc.poll() is not None:  # terminal gone without a status: the task never ran or was closed
                break
            time.sleep(0.5)
    try:
        with open(log, errors="replace") as f:
            tail = f.read()[-600:].strip().splitlines()
    except OSError:
        tail = None
    if rc is None or tail is None:
        # Never report success for a task that did not run (e.g. no display).
        try:
            with open(err_path, errors="replace") as f:
                why = (f.read().strip().splitlines() or [""])[-1][:160]
        except OSError:
            why = ""
        write_status(state="failed", summary=f"Task {n}: could not start or was closed early "
                                             f"(terminal exit {proc.poll()}{': ' + why if why else ''})")
        return
    if rc != 0:
        last = tail[-1] if tail else "no output"
        write_status(state="failed", summary=f"Task {n}: exit {rc}: {last[:220]}")
        return
    summary = tail[-1] if tail else "completed (no output)"
    write_status(state="done", summary=f"Task {n}: {summary[:240]}")


def inbox_loop():
    os.makedirs(WORKSPACE, exist_ok=True)
    os.chown(WORKSPACE, AGENT.pw_uid, AGENT.pw_gid)
    while True:
        try:
            names = sorted(n for n in os.listdir(INBOX) if n.endswith(".json") and not n.startswith("."))
        except OSError:
            names = []
        for name in names:
            path = os.path.join(INBOX, name)
            try:
                with open(path) as f:
                    msg = json.load(f)
                os.unlink(path)
            except (OSError, ValueError):
                continue
            if msg.get("type") == "instruction" and msg.get("text"):
                run_instruction(str(msg["text"]))
        time.sleep(1)


def shutdown_watcher():
    """VM agents: power off when the host service asks (its own thread, so a
    task that is still running or waiting for approval cannot delay it)."""
    path = os.path.join(CONTROL, "shutdown")
    while True:
        try:
            # Written by the host service (root, like approval responses); the
            # agent user cannot create a root-owned file here.
            if os.stat(path).st_uid == 0:
                os.unlink(path)
                write_status(state="stopping", summary="shutting down")
                subprocess.run(["systemctl", "poweroff", "--no-block"])
        except OSError:
            pass
        time.sleep(1)


def elevate_server():
    """Serve iron-elevate: run an approved root command, stream back its output."""
    if os.path.exists(ELEVATE_SOCK):
        os.unlink(ELEVATE_SOCK)
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(ELEVATE_SOCK)
    os.chmod(ELEVATE_SOCK, 0o666)
    srv.listen(4)
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=handle_elevate, args=(conn,), daemon=True).start()


def handle_elevate(conn):
    with conn:
        try:
            rid = conn.recv(64).decode().strip()
            if not rid.isalnum():
                return
            req_path = os.path.join(CONTROL, "requests", f"{rid}.json")
            resp_path = os.path.join(CONTROL, "responses", f"{rid}.json")
            with open(req_path, "rb") as f:
                raw = f.read()
            req = json.loads(raw)
            with open(resp_path) as f:
                resp = json.load(f)
            # The response directory is writable only by root (the host side).
            # ...and the approval must match the request bytes the owner reviewed.
            if (os.stat(resp_path).st_uid != 0 or not resp.get("allow") or req.get("kind") != "elevate"
                    or resp.get("request_sha256") != hashlib.sha256(raw).hexdigest()):
                conn.sendall(b"denied\n")
                return
            argv = req.get("argv")
            if not isinstance(argv, list) or not argv:
                return
            p = subprocess.run(argv, capture_output=True, text=True, timeout=3600)
            conn.sendall((p.stdout + p.stderr + f"\n[exit {p.returncode}]\n").encode())
            os.unlink(resp_path)  # one approval, one execution
        except (OSError, ValueError, subprocess.SubprocessError) as e:
            try:
                conn.sendall(f"error: {e}\n".encode())
            except OSError:
                pass


if __name__ == "__main__":
    write_status()
    threading.Thread(target=elevate_server, daemon=True).start()
    if in_vm():
        threading.Thread(target=shutdown_watcher, daemon=True).start()
    inbox_loop()
