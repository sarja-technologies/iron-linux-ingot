[Plymouth Theme]
Name=Iron Linux Ingot
Description=Iron Linux Ingot boot splash (graphite, ingot wordmark, spinner)
ModuleName=two-step

[two-step]
Font=Inter 12
TitleFont=Inter Light 30
ImageDir=/usr/share/plymouth/themes/iron-ingot
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.72
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0e1115
BackgroundEndColor=0x0e1115
ProgressBarBackgroundColor=0x20262d
ProgressBarForegroundColor=0x3d7be0
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates…
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Iron Linux…
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading firmware…
SubTitle=Do not turn off your computer
